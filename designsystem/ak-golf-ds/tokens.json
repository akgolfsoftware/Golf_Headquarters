{
  "$description": "AK Golf — eneste kilde for tokens. W3C Design Tokens (DTCG). Alle tokens/*.css, tokens.types.ts og tailwind.css GENERERES fra denne filen av tokens/build.mjs. Rediger aldri de genererte filene.\nLag: color/size/type.scale = råverdi (ingen mening) → role = rolle i merket → component = bundet til ett navngitt element. Komponent-CSS bruker bare role- og component-laget.",
  "color": {
    "$type": "color",
    "$description": "Palett. Ingen farge legges til uten at en fjernes.",
    "sand": {
      "$extensions": { "ak": { "prefix": "sand", "file": "colors", "group": "Sand (flater)" } },
      "100": { "$value": "#faf8f3" },
      "150": { "$value": "#f1eee8" },
      "200": { "$value": "#e6e3dd" },
      "300": { "$value": "#ddd9d1", "$description": "Hårstrek. Kun via --border-hairline." },
      "400": { "$value": "#c9c4ba", "$description": "Sterk strek. Kun via --border-strong." }
    },
    "white": { "$value": "#fff", "$extensions": { "ak": { "var": "white", "file": "colors", "group": "Sand (flater)" } } },
    "graphite": {
      "$extensions": { "ak": { "prefix": "graphite", "file": "colors", "group": "Grafitt (blekk)", "order": ["900","800","600","500","400"] } },
      "900": { "$value": "#141413" },
      "800": { "$value": "#2a2926" },
      "600": { "$value": "#46443f" },
      "500": { "$value": "#686560", "$description": "Mørknet fra #6b6862 21.09.2026 — 4.34 mot --surface-page var under AA. Nå 4.53." },
      "400": { "$value": "#8a8680" }
    },
    "rust": {
      "$extensions": { "ak": { "prefix": "rust", "file": "colors", "group": "Rust (handling — eneste handlingsfarge)", "order": ["600","hover","200","100"] } },
      "600": { "$value": "#9b2415" },
      "hover": { "$value": "#d81e20" },
      "200": { "$value": "#e9c6c2", "$description": "Handlingsstrek på tintet panel." },
      "100": { "$value": "#fbebea" }
    },
    "amber": {
      "$extensions": { "ak": { "prefix": "amber", "file": "colors", "group": "Amber (KUN advarsel)", "order": ["700","200","50"] } },
      "700": { "$value": "#7e6110", "$description": "Mørknet fra #8a6a12 21.09.2026 — 3.95 mot --surface-page var under AA. Nå 4.55." },
      "200": { "$value": "#e4d5a8", "$description": "Advarselsstrek. Erstatter dupletten #e8dcb8." },
      "50": { "$value": "#fbf4e4" }
    },
    "blue": {
      "$extensions": { "ak": { "prefix": "blue", "file": "colors", "group": "Blå (KUN lenke / info)" } },
      "800": { "$value": "#1d3557" }
    },
    "natt": {
      "$extensions": { "ak": { "prefix": "natt", "file": "colors", "group": "Natt (KUN eid av [data-surface=live])", "order": ["900","850","700","500","300"] } },
      "900": { "$value": "#141413" },
      "850": { "$value": "#1c1b1a" },
      "700": { "$value": "#2e2c29" },
      "500": { "$value": "#6b6560" },
      "300": { "$value": "#a8a49c" }
    },
    "data": {
      "$description": "Data-hues — råverdi, ingen mening. Generert i OKLCH, ikke plukket i øyemål: fem kategorier på L 0,45 / C 0,12 med 72° mellom hver, så ingen kategori er lysere enn en annen (lik luminans = ingen falsk rangering) og minste innbyrdes avstand er dE 0,111 i OKLab.\nStigen er fem trinn med jævn kontrast 1,75:1 mellom naboer. Bruk role.data — aldri disse direkte.",
      "$extensions": { "ak": { "prefix": "hue", "file": "colors", "group": "Data-hues (råverdi — bruk role.data)", "order": ["petrol","indigo","skog","plomme","kobber","vinrod","trinn-1","trinn-2","trinn-3","trinn-4","trinn-5"] } },
      "petrol": { "$value": "#006675" },
      "indigo": { "$value": "#434d97" },
      "skog": { "$value": "#13662b" },
      "plomme": { "$value": "#7f366a" },
      "kobber": { "$value": "#844000", "$description": "Varmest av datafargene. Aldri på en flate som kan forveksles med en knapp." },
      "vinrod": { "$value": "#863359", "$description": "Fortegn under null. dE 0,093 fra --rust-600 og 0,031 fra --hue-plomme: derfor kan fortegn og kategori aldri stå i samme graf." },
      "trinn-1": { "$value": "#e0eaeb" },
      "trinn-2": { "$value": "#a0b5b9" },
      "trinn-3": { "$value": "#6b8990" },
      "trinn-4": { "$value": "#3e636c" },
      "trinn-5": { "$value": "#123f4a" }
    },
    "dataLive": {
      "$description": "Data-hues på Live. Samme fem hues på L 0,70, fordi de mørke faller til 2,3–2,8:1 mot natt-900 og forsvinner. Stigen snur: mørkest trinn 1, lysest trinn 5.",
      "$extensions": { "ak": { "prefix": "hue-live", "file": "colors", "group": "Data-hues på Live (råverdi)", "order": ["petrol","indigo","skog","plomme","kobber","vinrod","trinn-1","trinn-2","trinn-3","trinn-4","trinn-5"] } },
      "petrol": { "$value": "#2cb2bf" },
      "indigo": { "$value": "#8a99e3" },
      "skog": { "$value": "#6cb177" },
      "plomme": { "$value": "#cc83b4" },
      "kobber": { "$value": "#d18c56" },
      "vinrod": { "$value": "#d481a2" },
      "trinn-1": { "$value": "#24505a" },
      "trinn-2": { "$value": "#466f78" },
      "trinn-3": { "$value": "#6c9198" },
      "trinn-4": { "$value": "#96b8be" },
      "trinn-5": { "$value": "#c8e6e9" }
    }
  },
  "role": {
    "$type": "color",
    "$extensions": { "ak": { "file": "colors", "group": "Semantiske alias — dette laget bruker komponentene" } },
    "surface": {
      "$extensions": { "ak": { "prefix": "surface" } },
      "page": { "$value": "{color.sand.200}" },
      "flat": { "$value": "{color.sand.100}" },
      "raised": { "$value": "{color.white}" },
      "sunken": { "$value": "{color.sand.150}" },
      "hover": { "$value": "{color.sand.150}", "$description": "Pekeflate på lys grunn." },
      "disabled": { "$value": "{color.sand.150}", "$description": "Inaktiv kontrollflate." },
      "ink": { "$value": "{color.graphite.900}", "$description": "Blekkflate — valgt pill, avatar, avkrysning, fokuspanel, solid knapp." },
      "ink-hover": { "$value": "{color.graphite.800}" },
      "inverse": { "$value": "{color.sand.100}", "$description": "Lys flate på blekk — ghost-inverse ved peker." },
      "focus": { "$value": "{color.graphite.900}" }
    },
    "text": {
      "$extensions": { "ak": { "prefix": "text" } },
      "primary": { "$value": "{color.graphite.900}" },
      "body": { "$value": "{color.graphite.800}" },
      "secondary": { "$value": "{color.graphite.600}" },
      "muted": { "$value": "{color.graphite.500}" },
      "faint": { "$value": "{color.graphite.400}" },
      "inverse": { "$value": "{color.sand.100}" },
      "inverse-soft": { "$value": "{color.sand.150}", "$description": "Sekundærtekst på blekkflate." }
    },
    "border": {
      "$extensions": { "ak": { "prefix": "border" } },
      "hairline": { "$value": "{color.sand.300}" },
      "strong": { "$value": "{color.sand.400}" },
      "ink": { "$value": "{color.graphite.900}" },
      "control": { "$value": "{color.graphite.500}", "$description": "Kontrollgrense (felt, ghost-knapp, pill, avkrysning). Holder 3:1 mot alle flater, også --surface-page (4.53) — ingen unntaksregel." },
      "warn": { "$value": "{color.amber.200}" },
      "action": { "$value": "{color.rust.200}" },
      "inverse": { "$value": "{color.natt.700}", "$description": "Strek på blekk- og Live-flate." },
      "on-ink": { "$value": "rgba(250,248,243,.55)", "$description": "Ghost-inverse-kant på blekk. Sand-100 med alfa." }
    },
    "action": {
      "$extensions": { "ak": { "prefix": "action" } },
      "_": { "$value": "{color.rust.600}" },
      "hover": { "$value": "{color.rust.hover}" },
      "tint": { "$value": "{color.rust.100}" },
      "text": { "$value": "{color.white}" }
    },
    "warn": {
      "$extensions": { "ak": { "prefix": "warn" } },
      "_": { "$value": "{color.amber.700}" },
      "tint": { "$value": "{color.amber.50}" }
    },
    "link": { "$value": "{color.blue.800}", "$extensions": { "ak": { "var": "link" } } },
    "info": { "$value": "{color.blue.800}", "$extensions": { "ak": { "var": "info" } } },
    "scrim": {
      "$extensions": { "ak": { "prefix": "scrim" } },
      "dialog": { "$value": "rgba(20,20,19,.4)", "$description": "Dialogteppe. Grafitt-900 med alfa." },
      "foto": { "$value": "rgba(20,20,19,.62)", "$description": "Teppe under data som ligger på et foto (Spredning med bane). Gjør flaten Live — men fotoet måles ikke: hvert merke bærer motstrek. Grafitt-900 med alfa." }
    },
    "focusRing": {
      "$extensions": { "ak": { "prefix": "focus-ring" } },
      "_": { "$value": "{color.graphite.900}" },
      "inverse": { "$value": "{color.sand.100}" }
    },
    "domene": {
      "$description": "KLASSIFIKASJON — aldri handling.\nLovlig bruk: 4px stav, kicker, DomainMeter-fyll, punkt i graf.\nForbudt: knapper, lenker, topplinje, tab-bar.\nFem egne hues fra datapaletten 21.09.2026 — før det lånte pyramiden rust og amber, og de fem lagene var ikke til å skille fra hverandre.",
      "$extensions": { "ak": { "prefix": "domene" } },
      "fys": { "$value": "{color.data.petrol}" },
      "tek": { "$value": "{color.data.indigo}" },
      "slag": { "$value": "{color.data.skog}" },
      "spill": { "$value": "{color.data.plomme}" },
      "turn": { "$value": "{color.data.kobber}" }
    },
    "data": {
      "$description": "DATAROLLER — kun fyll, strek og punkt inne i en målekomponent.\nForbudt: tekst som skal leses, knapper, lenker, chrome, kant på kontroll.\nFargen klassifiserer aldri alene: kategorien står i etiketten, fortegnet i tallet, rekkefølgen i posisjonen. Ta bort all farge, og grafen skal fortsatt kunne leses.\nTo krav, ikke ett: isolerte merker (punkt, stav, linje) holder 3:1 mot flaten — stigen holder 1,4:1 mellom naboer og bærer alltid --border-hairline mot flaten.\nEn graf er enten kategorisk eller fortegnsbærende. Aldri begge: --data-under ligger dE 0,031 fra --data-k4.",
      "$extensions": { "ak": { "prefix": "data" } },
      "k1": { "$value": "{color.data.petrol}", "$description": "Kategori 1 av 5. Rekkefølgen er fast — plukk aldri midt i lista. Ingen sjette kategori: trenger grafen en sjette, er grafen feil." },
      "k2": { "$value": "{color.data.indigo}" },
      "k3": { "$value": "{color.data.skog}" },
      "k4": { "$value": "{color.data.plomme}" },
      "k5": { "$value": "{color.data.kobber}" },
      "felt": { "$value": "{color.graphite.500}", "$description": "Referanse: feltsnitt, normalen, forrige periode. Alltid nøytral — sammenlikningsgrunnlaget er ikke en kategori." },
      "over": { "$value": "{color.data.skog}", "$description": "Over null / over mål. Fortegnet står i tallet uansett." },
      "under": { "$value": "{color.data.vinrod}", "$description": "Under null / under mål. Ikke en feiltilstand — bruk aldri --warn eller --action til dette." },
      "niva-1": { "$value": "{color.data.trinn-1}", "$description": "Ordinal stige, 5 trinn: pyramidenivå, avstandsbånd, tetthet. Etiketten hentes fra --data-ink-niva-N, aldri valgt i øyemål." },
      "niva-2": { "$value": "{color.data.trinn-2}" },
      "niva-3": { "$value": "{color.data.trinn-3}" },
      "niva-4": { "$value": "{color.data.trinn-4}" },
      "niva-5": { "$value": "{color.data.trinn-5}" },
      "ink-kat": { "$value": "{color.sand.100}", "$description": "Etikett oppå kategori-, felt- og fortegnsfyll. Holder 6,27:1 eller bedre på alle åtte." },
      "ink-niva-1": { "$value": "{color.graphite.900}", "$description": "Stigen skifter blekk der målingen sier den må: trinn 1–3 grafitt, 4–5 sand. På Live snur det ved trinn 3." },
      "ink-niva-2": { "$value": "{color.graphite.900}" },
      "ink-niva-3": { "$value": "{color.graphite.900}" },
      "ink-niva-4": { "$value": "{color.sand.100}" },
      "ink-niva-5": { "$value": "{color.sand.100}" }
    }
  },
  "surfaceLive": {
    "$type": "color",
    "$description": "Live: én flate, ikke dark mode. Overstyrer bare rollelaget.",
    "$extensions": { "ak": { "file": "colors", "selector": "[data-surface=\"live\"]" } },
    "surfacePage": { "$value": "{color.natt.900}", "$extensions": { "ak": { "var": "surface-page" } } },
    "surfaceFlat": { "$value": "{color.natt.850}", "$extensions": { "ak": { "var": "surface-flat" } } },
    "surfaceRaised": { "$value": "{color.natt.700}", "$extensions": { "ak": { "var": "surface-raised" } } },
    "surfaceSunken": { "$value": "{color.natt.850}", "$extensions": { "ak": { "var": "surface-sunken" } } },
    "surfaceHover": { "$value": "{color.natt.700}", "$extensions": { "ak": { "var": "surface-hover" } } },
    "surfaceDisabled": { "$value": "{color.natt.700}", "$extensions": { "ak": { "var": "surface-disabled" } } },
    "textPrimary": { "$value": "{color.sand.100}", "$extensions": { "ak": { "var": "text-primary" } } },
    "textBody": { "$value": "{color.sand.100}", "$extensions": { "ak": { "var": "text-body" } } },
    "textSecondary": { "$value": "{color.natt.300}", "$extensions": { "ak": { "var": "text-secondary" } } },
    "textMuted": { "$value": "{color.natt.300}", "$extensions": { "ak": { "var": "text-muted" } } },
    "textFaint": { "$value": "{color.natt.500}", "$extensions": { "ak": { "var": "text-faint" } } },
    "textInverse": { "$value": "{color.graphite.900}", "$extensions": { "ak": { "var": "text-inverse" } } },
    "textInverseSoft": { "$value": "{color.natt.300}", "$extensions": { "ak": { "var": "text-inverse-soft" } } },
    "borderHairline": { "$value": "{color.natt.700}", "$extensions": { "ak": { "var": "border-hairline" } } },
    "borderStrong": { "$value": "{color.natt.700}", "$extensions": { "ak": { "var": "border-strong" } } },
    "borderControl": { "$value": "{color.natt.300}", "$description": "Live hadde ingen kontrollgrense som holdt 3:1 — natt-700 ga 1.30 mot Live flat. Nå 7.03.", "$extensions": { "ak": { "var": "border-control" } } },
    "action": { "$value": "{color.rust.600}", "$description": "Bare som fyll med --action-text over. Rust som tekst eller strek på Live er 2.18:1.", "$extensions": { "ak": { "var": "action" } } },
    "actionTint": { "$value": "{color.natt.700}", "$extensions": { "ak": { "var": "action-tint" } } },
    "link": { "$value": "{color.sand.100}", "$description": "Blå lenke på natt er 1.39:1. På Live er lenker understreket, ikke blå.", "$extensions": { "ak": { "var": "link" } } },
    "warn": { "$value": "{color.amber.200}", "$extensions": { "ak": { "var": "warn" } } },
    "warnTint": { "$value": "{color.natt.700}", "$extensions": { "ak": { "var": "warn-tint" } } },
    "actionHover": { "$value": "{color.rust.hover}", "$extensions": { "ak": { "var": "action-hover" } } },
    "scrim": {
      "$extensions": { "ak": { "prefix": "scrim" } },
      "dialog": { "$value": "rgba(20,20,19,.4)", "$description": "Dialogteppe. Grafitt-900 med alfa." }
    },
    "focusRing": { "$value": "{role.focusRing.inverse}", "$extensions": { "ak": { "var": "focus-ring" } } },
    "data": {
      "$description": "Datafargene på Live. Samme rollenavn, lysere verdi — de mørke kategorifargene faller til under 2:1 mot natt-900 og forsvinner.",
      "$extensions": { "ak": { "prefix": "data" } },
      "k1": { "$value": "{color.dataLive.petrol}" },
      "k2": { "$value": "{color.dataLive.indigo}" },
      "k3": { "$value": "{color.dataLive.skog}" },
      "k4": { "$value": "{color.dataLive.plomme}" },
      "k5": { "$value": "{color.dataLive.kobber}" },
      "felt": { "$value": "{color.natt.300}" },
      "over": { "$value": "{color.dataLive.skog}" },
      "under": { "$value": "{color.dataLive.vinrod}" },
      "niva-1": { "$value": "{color.dataLive.trinn-1}" },
      "niva-2": { "$value": "{color.dataLive.trinn-2}" },
      "niva-3": { "$value": "{color.dataLive.trinn-3}" },
      "niva-4": { "$value": "{color.dataLive.trinn-4}" },
      "niva-5": { "$value": "{color.dataLive.trinn-5}" },
      "ink-kat": { "$value": "{color.graphite.900}", "$description": "På Live er kategorifargene de lyse — blekket snur." },
      "ink-niva-1": { "$value": "{color.sand.100}", "$description": "Stigen snur på Live: trinn 1–2 sand, 3–5 grafitt." },
      "ink-niva-2": { "$value": "{color.sand.100}" },
      "ink-niva-3": { "$value": "{color.graphite.900}" },
      "ink-niva-4": { "$value": "{color.graphite.900}" },
      "ink-niva-5": { "$value": "{color.graphite.900}" }
    },
    "domene": {
      "$extensions": { "ak": { "prefix": "domene" } },
      "fys": { "$value": "{color.dataLive.petrol}" },
      "tek": { "$value": "{color.dataLive.indigo}" },
      "slag": { "$value": "{color.dataLive.skog}" },
      "spill": { "$value": "{color.dataLive.plomme}" },
      "turn": { "$value": "{color.dataLive.kobber}" }
    }
  },
  "fonts": {
    "$description": "Tre familier, ingen fjerde. Weights her er de eneste som lastes — legg aldri til en vekt uten å fjerne en.",
    "$extensions": { "ak": { "file": "fonts" } },
    "display": { "$value": "Oswald", "$extensions": { "ak": { "weights": [600], "spec": "wght@600", "fallbackLocal": "Arial", "fallback": { "sizeAdjust": "91.5%", "ascent": "130.1%", "descent": "31.7%" }, "role": "DISPLAY — bare .aos-title, .aos-metric, kicker over 17 px, Live-tall" } } },
    "body": { "$value": "Archivo", "$extensions": { "ak": { "weights": [400, 500, 600], "spec": "ital,wght@0,400;0,500;0,600;1,400", "fallbackLocal": "Arial", "fallback": { "sizeAdjust": "106.1%", "ascent": "83.0%", "descent": "19.8%" }, "role": "BODY — alt arbeid: chrome, pills, knapper, felt, inspektør, brød, tabbar" } } },
    "meta": { "$value": "IBM Plex Mono", "$extensions": { "ak": { "weights": [400, 500], "spec": "wght@400;500", "fallbackLocal": "Courier New", "fallback": { "sizeAdjust": "99.7%", "ascent": "102.3%", "descent": "27.1%" }, "role": "META — bare målt data: kl. 16:00, +1,2, 3–5 fot, kilde, SG-kode" } } }
  },
  "type": {
    "$extensions": { "ak": { "file": "typography" } },
    "family": {
      "$type": "fontFamily",
      "$extensions": { "ak": { "prefix": "font", "group": "TYPOGRAFI-LOV — tre familier, ingen fjerde" } },
      "display": { "$value": "\"Oswald\",\"Oswald Fallback\",system-ui,sans-serif" },
      "body": { "$value": "\"Archivo\",\"Archivo Fallback\",system-ui,sans-serif" },
      "meta": { "$value": "\"IBM Plex Mono\",\"IBM Plex Mono Fallback\",ui-monospace,monospace" },
      "mono": { "$value": "{type.family.meta}", "$description": "Bakoverkompatibelt alias." }
    },
    "scale": {
      "$type": "dimension",
      "$extensions": { "ak": { "prefix": "fs", "group": "Skala — 10 trinn, ingen andre størrelser", "inline": true } },
      "10": { "$value": "10px" },
      "11": { "$value": "11px" },
      "13": { "$value": "13px" },
      "14": { "$value": "14px" },
      "15": { "$value": "15px" },
      "17": { "$value": "17px" },
      "21": { "$value": "21px" },
      "26": { "$value": "26px" },
      "29": { "$value": "29px" },
      "40": { "$value": "40px" }
    },
    "lh": {
      "$type": "number",
      "$extensions": { "ak": { "prefix": "lh", "kind": "font" } },
      "tight": { "$value": 1.05 },
      "snug": { "$value": 1.2 },
      "normal": { "$value": 1.45 },
      "loose": { "$value": 1.6 }
    },
    "tracking": {
      "$type": "dimension",
      "$extensions": { "ak": { "prefix": "tracking" } },
      "kicker": { "$value": "0.08em", "$description": "0.11 brakk «Godkjenninger» og «TRENINGSOMRÅDE»" },
      "kicker-min": { "$value": "0.06em" },
      "kicker-max": { "$value": "0.08em" },
      "display": { "$value": "-0.01em" },
      "meta": { "$value": "0.02em" }
    },
    "fw": {
      "$type": "fontWeight",
      "$extensions": { "ak": { "prefix": "fw", "kind": "font" } },
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 }
    },
    "role": {
      "$type": "typography",
      "$description": "Semantiske roller. En rolle kan bare plukke fra skalaen og de tre familiene — ingen vilkårlige verdier.",
      "$extensions": { "ak": { "prefix": "type", "group": "Semantiske roller" } },
      "kicker": { "$value": { "fontWeight": "{type.fw.semibold}", "fontSize": "{type.scale.11}", "lineHeight": "{type.lh.snug}", "fontFamily": "{type.family.body}" }, "$description": "under 17 px = Archivo, aldri Oswald" },
      "title-xl": { "$value": { "fontWeight": "{type.fw.semibold}", "fontSize": "{type.scale.40}", "lineHeight": "{type.lh.tight}", "fontFamily": "{type.family.display}" } },
      "title-l": { "$value": { "fontWeight": "{type.fw.semibold}", "fontSize": "{type.scale.29}", "lineHeight": "{type.lh.tight}", "fontFamily": "{type.family.display}" } },
      "title-m": { "$value": { "fontWeight": "{type.fw.semibold}", "fontSize": "{type.scale.21}", "lineHeight": "{type.lh.snug}", "fontFamily": "{type.family.display}" } },
      "title-s": { "$value": { "fontWeight": "{type.fw.semibold}", "fontSize": "{type.scale.17}", "lineHeight": "{type.lh.snug}", "fontFamily": "{type.family.display}" } },
      "lead": { "$value": { "fontWeight": "{type.fw.regular}", "fontSize": "{type.scale.17}", "lineHeight": "{type.lh.normal}", "fontFamily": "{type.family.body}" } },
      "body": { "$value": { "fontWeight": "{type.fw.regular}", "fontSize": "{type.scale.15}", "lineHeight": "{type.lh.normal}", "fontFamily": "{type.family.body}" } },
