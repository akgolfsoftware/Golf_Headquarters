{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "AK Golf — merkets tokens som DATA. Dette er den ene kilden. tokens/*.css, tokens/tailwind-theme.css, ak-golf-tokens.ts og tokens/kontrast.md GENERERES herfra med `node scripts/ak-golf-tokens.mjs --write` (i kodebasen), og `--check` (i npm run verify) feiler hvis noen av dem har sklidd. Endre aldri de genererte filene for hånd. Verdiene ble låst av Anders 01.09.2026 (verkstedet); kontrasttall måles av skriptet, ikke skrives inn. Produktskjermene (PlayerHQ, AgencyOS, Forelder) bruker Train-lock, ikke dette.",
  "$version": "1.0.0",
  "filer": {
    "farge.css": "AK Golf — farge.\n   GENERERT fra tokens.json — ikke rediger her.\n\n   Merket hører hjemme i et verksted, ikke i et klubbhus. Det følger av det\n   Academy faktisk står for: langsiktig utvikling, oppfølging, og trening som\n   er optimal og spesifikk — uavhengig av hvilket nivå spilleren er på.\n\n   De fleste golfmerker signaliserer eksklusivitet: dyp grønn, gull, marmor,\n   seriffer. Det sier «her må du være god nok». AK Golf sier det motsatte, og\n   da kan ikke fargene motsi teksten.\n\n   Grunnen er varm betonggrå. Signalfargen er rød, og den brukes som en\n   markering på en måling — ikke som energi eller hausing. Ingenting her er\n   premium, og det er meningen. Et godt verktøy er ikke pyntet; det er nøyaktig.\n\n   Kontrasttallene i kommentarene er MÅLT av generatoren (WCAG 2.x), ikke\n   anslått. Full tabell: tokens/kontrast.md.\n\n   LYS ER STANDARD. Den mørke varianten er verkstedet om kvelden — den finnes,\n   men den er ikke utgangspunktet.",
    "type.css": "AK Golf — typografi.\n   GENERERT fra tokens.json — ikke rediger her.\n\n   Hele IBM Plex-familien. Ingen andre fonter.\n   IBM Plex Sans Condensed — overskrifter. Alt som skal dominere en flate.\n   IBM Plex Sans           — brødtekst, knapper, skjema.\n   IBM Plex Mono           — alt som er MÅLT.\n\n   Én familie, tre roller. Valgt 01.09.2026 etter test mot Archivo Narrow +\n   Poppins: Plex Sans er tettere, og brødtekst som brøt til tre linjer klarer\n   seg på to. Produktskjermene bruker fortsatt Poppins gjennom Train-lock.",
    "rom.css": "AK Golf — rom, geometri og dybde.\n   GENERERT fra tokens.json — ikke rediger her.\n\n   Romskalaen er en 4-basis. Alt avstandsmål i merket er et av disse tallene.\n   Er svaret «22px», er det feil — velg 20 eller 24. Regelen finnes fordi\n   luft er den billigste måten å se dyr ut på, og den eneste som ryker først\n   når noen har dårlig tid.",
    "bevegelse.css": "AK Golf — bevegelse.\n   GENERERT fra tokens.json — ikke rediger her.\n\n   Merket beveger seg lite, og alltid av en grunn. En animasjon skal svare\n   på «hvor kom dette fra» eller «hva skjedde nå» — aldri på «se her».\n   Et system som påstår at det måler, kan ikke oppføre seg som en reklame.",
    "instrument.css": "AK Golf — instrumentlaget.\n   GENERERT fra tokens.json — ikke rediger her.\n\n   Merkets grafiske element, hentet fra det AK Golf gjør: spredningsellipsen,\n   pyramideaksene, avstanden fra pinnen.\n\n   REGELEN SOM HOLDER DET ÆRLIG: instrumentlaget skal aldri gi inntrykk av å\n   vise data som ikke finnes. Et rutenett i bakgrunnen er tekstur. Et rutenett\n   med tall på aksene er en påstand — og da må tallene være målt, med dato og\n   kilde."
  },
  "ak": {
    "farge": {
      "grunn":        { "$type": "color", "$value": "#E8E4DC", "$description": "varm betonggrå — hovedflate", "$extensions": { "css": "--ak-grunn", "fil": "farge.css", "mork": "#22201C" } },
      "grunn-senk":   { "$type": "color", "$value": "#DDD8CE", "$description": "seksjon som skal skille seg", "$extensions": { "css": "--ak-grunn-senk", "fil": "farge.css", "mork": "#1A1815" } },
      "ark":          { "$type": "color", "$value": "#FFFFFF", "$description": "kort og ark som ligger PÅ grunnen", "$extensions": { "css": "--ak-ark", "fil": "farge.css", "mork": "#2C2925" } },
      "tekst":        { "$type": "color", "$value": "#1F1D1A", "$description": "brødtekst", "$extensions": { "css": "--ak-tekst", "fil": "farge.css", "mork": "#F2EFE8" } },
      "dempet":       { "$type": "color", "$value": "#57534B", "$description": "brødtekst som er underordnet", "$extensions": { "css": "--ak-dempet", "fil": "farge.css", "mork": "#A8A196" } },
      "svak":         { "$type": "color", "$value": "#8B857A", "$description": "ALDRI brødtekst. Kun etiketter og kanter", "$extensions": { "css": "--ak-svak", "fil": "farge.css", "mork": "#75706A" } },
      "linje":        { "$type": "color", "$value": "#D2CCC0", "$description": "hårlinje", "$extensions": { "css": "--ak-linje", "fil": "farge.css", "mork": "#38342E" } },
      "linje-hard":   { "$type": "color", "$value": "#B8B1A3", "$description": "der to flater møtes og skillet skal sees", "$extensions": { "css": "--ak-linje-hard", "fil": "farge.css", "mork": "#4A453D" } },
      "signal":       { "$type": "color", "$value": "#B83217", "$description": "Merkets ene aksent. Rødt betyr «se her» — en måling, et tall, en handling. Aldri dekor. Som tekst kun på grunn og ark; på senket flate og på mørk ark kun som tall fra 21 px (stor tekst, 3:1)", "$extensions": { "css": "--ak-signal", "fil": "farge.css", "mork": "#E8654A" } },
      "signal-fyll":  { "$type": "color", "$value": "#C4361B", "$description": "mer mettet, for hele flater", "$extensions": { "css": "--ak-signal-fyll", "fil": "farge.css", "mork": "#C4361B" } },
      "signal-tekst": { "$type": "color", "$value": "#FFFFFF", "$description": "tekst oppå signalfyllet", "$extensions": { "css": "--ak-signal-tekst", "fil": "farge.css", "mork": "#FFFFFF" } },
      "signal-myk":   { "$type": "color", "$value": "rgba(184, 50, 23, 0.10)", "$description": "svakt underlag for en signalmarkering", "$extensions": { "css": "--ak-signal-myk", "fil": "farge.css", "mork": "rgba(232, 101, 74, 0.14)" } },
      "fag":          { "$type": "color", "$value": "#2C6E63", "$description": "Andrestemme, sjelden brukt. Dyp grønnblå for det som hører til metoden framfor til målingen: pyramiden, periodene, langsiktige linjer", "$extensions": { "css": "--ak-fag", "fil": "farge.css", "mork": "#5FA89A" } },
      "v-junior":     { "$type": "color", "$value": "#4A6B33", "$description": "Varianttone. Dempede arbeidstoner, ikke fem glade farger — merket for å skilles fra hverandre, ikke mer", "$extensions": { "css": "--ak-v-junior", "fil": "farge.css", "mork": "#8FB37F" } },
      "v-academy":    { "$type": "color", "$value": "{ak.farge.signal}", "$description": "Academy låner signalet, fordi Academy ER kjernen — ingen annen variant får noe som ligner", "$extensions": { "css": "--ak-v-academy", "fil": "farge.css", "mork": "{ak.farge.signal}" } },
      "v-hq":         { "$type": "color", "$value": "#2B5F87", "$extensions": { "css": "--ak-v-hq", "fil": "farge.css", "mork": "#7FB0DA" } },
      "v-org":        { "$type": "color", "$value": "#4A4F58", "$extensions": { "css": "--ak-v-org", "fil": "farge.css", "mork": "#A3AAB5" } },
      "v-produkt":    { "$type": "color", "$value": "#7A5A22", "$extensions": { "css": "--ak-v-produkt", "fil": "farge.css", "mork": "#C9A755" } },
      "ok":           { "$type": "color", "$value": "#2E6B45", "$description": "Status. Aldri identitet", "$extensions": { "css": "--ak-ok", "fil": "farge.css", "mork": "#7FBF98" } },
      "varsel":       { "$type": "color", "$value": "#755608", "$description": "Status. Rettet 02.09.2026 fra #8A6410 (4,2:1 — under kravet)", "$extensions": { "css": "--ak-varsel", "fil": "farge.css", "mork": "#D9B25A" } },
      "feil":         { "$type": "color", "$value": "#A62B1C", "$description": "Status. Mørkere enn signalet med vilje; på mørk flate lysere og blassere enn signalet, samme grunn", "$extensions": { "css": "--ak-feil", "fil": "farge.css", "mork": "#F08A73" } }
    },
    "type": {
      "display": { "$type": "fontFamily", "$value": ["IBM Plex Sans Condensed", "IBM Plex Sans", "Helvetica Neue", "Arial", "sans-serif"], "$extensions": { "css": "--ak-display", "fil": "type.css" } },
      "sans":    { "$type": "fontFamily", "$value": ["IBM Plex Sans", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Arial", "sans-serif"], "$extensions": { "css": "--ak-sans", "fil": "type.css" } },
      "mono":    { "$type": "fontFamily", "$value": ["IBM Plex Mono", "ui-monospace", "SFMono-Regular", "Menlo", "monospace"], "$extensions": { "css": "--ak-mono", "fil": "type.css" } },
      "t-11":  { "$type": "dimension", "$value": "11px",  "$description": "etikett i caps, kun mono", "$extensions": { "css": "--ak-t-11", "fil": "type.css" } },
      "t-13":  { "$type": "dimension", "$value": "13px",  "$description": "bildetekst, fotnote", "$extensions": { "css": "--ak-t-13", "fil": "type.css" } },
      "t-15":  { "$type": "dimension", "$value": "15px",  "$description": "brødtekst, tett", "$extensions": { "css": "--ak-t-15", "fil": "type.css" } },
      "t-17":  { "$type": "dimension", "$value": "17px",  "$description": "brødtekst, standard", "$extensions": { "css": "--ak-t-17", "fil": "type.css" } },
      "t-21":  { "$type": "dimension", "$value": "21px",  "$description": "ingress", "$extensions": { "css": "--ak-t-21", "fil": "type.css" } },
      "t-26":  { "$type": "dimension", "$value": "26px",  "$description": "seksjonstittel, mobil", "$extensions": { "css": "--ak-t-26", "fil": "type.css" } },
      "t-34":  { "$type": "dimension", "$value": "34px",  "$description": "seksjonstittel", "$extensions": { "css": "--ak-t-34", "fil": "type.css" } },
      "t-48":  { "$type": "dimension", "$value": "48px",  "$description": "sidetittel", "$extensions": { "css": "--ak-t-48", "fil": "type.css" } },
      "t-72":  { "$type": "dimension", "$value": "72px",  "$description": "hero, mobil", "$extensions": { "css": "--ak-t-72", "fil": "type.css" } },
      "t-112": { "$type": "dimension", "$value": "112px", "$description": "hero, Mac", "$extensions": { "css": "--ak-t-112", "fil": "type.css" } },
      "t-hero":    { "$type": "dimension", "$value": "clamp(72px, 4vw + 56px, 112px)", "$description": "flytende hero: 72 på 390, 112 på 1440. Lagt til 02.09.2026 — mellom mobil og Mac fantes ingen verdi", "$extensions": { "css": "--ak-t-hero", "fil": "type.css" } },
      "t-seksjon": { "$type": "dimension", "$value": "clamp(26px, 0.76vw + 23px, 34px)", "$description": "flytende seksjonstittel: 26 på 390, 34 på 1440", "$extensions": { "css": "--ak-t-seksjon", "fil": "type.css" } },
      "v-400": { "$type": "fontWeight", "$value": 400, "$extensions": { "css": "--ak-v-400", "fil": "type.css" } },
      "v-500": { "$type": "fontWeight", "$value": 500, "$extensions": { "css": "--ak-v-500", "fil": "type.css" } },
      "v-600": { "$type": "fontWeight", "$value": 600, "$extensions": { "css": "--ak-v-600", "fil": "type.css" } },
      "v-700": { "$type": "fontWeight", "$value": 700, "$description": "KUN Plex Sans Condensed. Aldri Plex Sans", "$extensions": { "css": "--ak-v-700", "fil": "type.css" } },
      "lh-display": { "$type": "number", "$value": 0.94, "$description": "fra 48px og opp — linjene skal låse seg til hverandre", "$extensions": { "css": "--ak-lh-display", "fil": "type.css" } },
      "lh-tett":    { "$type": "number", "$value": 1.12, "$extensions": { "css": "--ak-lh-tett", "fil": "type.css" } },
      "lh-normal":  { "$type": "number", "$value": 1.5,  "$extensions": { "css": "--ak-lh-normal", "fil": "type.css" } },
      "sp-display": { "$type": "dimension", "$value": "-0.035em", "$extensions": { "css": "--ak-sp-display", "fil": "type.css" } },
      "sp-titt":    { "$type": "dimension", "$value": "-0.02em",  "$extensions": { "css": "--ak-sp-titt", "fil": "type.css" } },
      "sp-null":    { "$type": "dimension", "$value": "0",        "$extensions": { "css": "--ak-sp-null", "fil": "type.css" } },
      "sp-vid":     { "$type": "dimension", "$value": "0.2em",    "$description": "caps-etiketter i mono", "$extensions": { "css": "--ak-sp-vid", "fil": "type.css" } },
      "sp-vidt":    { "$type": "dimension", "$value": "0.24em",   "$description": "samme, på mørk flate der lyset spiser mellomrom", "$extensions": { "css": "--ak-sp-vidt", "fil": "type.css" } }
    },
    "rom": {
      "r-1":  { "$type": "dimension", "$value": "4px",   "$extensions": { "css": "--ak-r-1", "fil": "rom.css" } },
      "r-2":  { "$type": "dimension", "$value": "8px",   "$extensions": { "css": "--ak-r-2", "fil": "rom.css" } },
      "r-3":  { "$type": "dimension", "$value": "12px",  "$extensions": { "css": "--ak-r-3", "fil": "rom.css" } },
      "r-4":  { "$type": "dimension", "$value": "16px",  "$extensions": { "css": "--ak-r-4", "fil": "rom.css" } },
      "r-5":  { "$type": "dimension", "$value": "24px",  "$extensions": { "css": "--ak-r-5", "fil": "rom.css" } },
      "r-6":  { "$type": "dimension", "$value": "32px",  "$extensions": { "css": "--ak-r-6", "fil": "rom.css" } },
      "r-7":  { "$type": "dimension", "$value": "48px",  "$extensions": { "css": "--ak-r-7", "fil": "rom.css" } },
      "r-8":  { "$type": "dimension", "$value": "64px",  "$extensions": { "css": "--ak-r-8", "fil": "rom.css" } },
      "r-9":  { "$type": "dimension", "$value": "96px",  "$description": "mellom seksjoner, mobil", "$extensions": { "css": "--ak-r-9", "fil": "rom.css" } },
      "r-10": { "$type": "dimension", "$value": "128px", "$description": "mellom seksjoner, Mac", "$extensions": { "css": "--ak-r-10", "fil": "rom.css" } },
      "hjorne-0":    { "$type": "dimension", "$value": "0",     "$extensions": { "css": "--ak-hjorne-0", "fil": "rom.css", "kind": "radius" } },
      "hjorne-sm":   { "$type": "dimension", "$value": "6px",   "$description": "knapp, merkelapp, felt", "$extensions": { "css": "--ak-hjorne-sm", "fil": "rom.css" } },
      "hjorne-md":   { "$type": "dimension", "$value": "10px",  "$description": "kort", "$extensions": { "css": "--ak-hjorne-md", "fil": "rom.css" } },
      "hjorne-lg":   { "$type": "dimension", "$value": "16px",  "$description": "panel, stor flate", "$extensions": { "css": "--ak-hjorne-lg", "fil": "rom.css" } },
      "hjorne-pill": { "$type": "dimension", "$value": "999px", "$description": "KUN knapper og filter-piller", "$extensions": { "css": "--ak-hjorne-pill", "fil": "rom.css" } },
      "loft-1": { "$type": "shadow", "$value": "0 1px 2px rgba(20, 20, 19, 0.05)", "$description": "Dybde: tre nivåer, ikke flere. Skyggene er varme (blekk, ikke svart) så de ikke blir grå flekker på betongen", "$extensions": { "css": "--ak-loft-1", "fil": "rom.css" } },
      "loft-2": { "$type": "shadow", "$value": "0 1px 2px rgba(20, 20, 19, 0.04), 0 8px 24px rgba(20, 20, 19, 0.06)", "$extensions": { "css": "--ak-loft-2", "fil": "rom.css" } },
      "loft-3": { "$type": "shadow", "$value": "0 2px 4px rgba(20, 20, 19, 0.05), 0 18px 48px rgba(20, 20, 19, 0.10)", "$extensions": { "css": "--ak-loft-3", "fil": "rom.css" } },
      "lesebredde": { "$type": "dimension", "$value": "65ch",   "$description": "brødtekst slutter her, uansett skjermbredde", "$extensions": { "css": "--ak-lesebredde", "fil": "rom.css", "kind": "other" } },
      "sidebredde": { "$type": "dimension", "$value": "1180px", "$extensions": { "css": "--ak-sidebredde", "fil": "rom.css", "kind": "other" } },
      "treff":      { "$type": "dimension", "$value": "44px",   "$description": "minste trykkflate, mobil", "$extensions": { "css": "--ak-treff", "fil": "rom.css", "kind": "other" } },
      "bp-mobil":   { "$type": "dimension", "$value": "390px", "$description": "Brekkpunkter. Lagt til 02.09.2026 — før fantes bare 390 og 1440. Mobil er den viktigste visningen", "$extensions": { "css": "--ak-bp-mobil", "fil": "rom.css", "kind": "other" } },
      "bp-tablet":  { "$type": "dimension", "$value": "768px", "$description": "iPad stående — flaten foreldre leser rapporter på", "$extensions": { "css": "--ak-bp-tablet", "fil": "rom.css", "kind": "other" } },
      "bp-mac":     { "$type": "dimension", "$value": "1180px", "$description": "fra her gjelder full sidebredde", "$extensions": { "css": "--ak-bp-mac", "fil": "rom.css", "kind": "other" } }
    },
    "bevegelse": {
      "fart-rask":  { "$type": "duration", "$value": "120ms", "$description": "hover, fokus, trykk", "$extensions": { "css": "--ak-fart-rask", "fil": "bevegelse.css", "redusert": "0ms", "kind": "other" } },
      "fart-mid":   { "$type": "duration", "$value": "220ms", "$description": "panel åpner, innhold bytter", "$extensions": { "css": "--ak-fart-mid", "fil": "bevegelse.css", "redusert": "0ms", "kind": "other" } },
      "fart-rolig": { "$type": "duration", "$value": "420ms", "$description": "seksjon kommer til syne ved rull", "$extensions": { "css": "--ak-fart-rolig", "fil": "bevegelse.css", "redusert": "0ms", "kind": "other" } },
      "kurve":      { "$type": "cubicBezier", "$value": "cubic-bezier(0.2, 0, 0.2, 1)", "$description": "Aldri ease-in alene: det får grensesnittet til å føles tregt i starten", "$extensions": { "css": "--ak-kurve", "fil": "bevegelse.css", "kind": "other" } },
      "kurve-inn":  { "$type": "cubicBezier", "$value": "cubic-bezier(0, 0, 0.2, 1)", "$extensions": { "css": "--ak-kurve-inn", "fil": "bevegelse.css", "kind": "other" } }
    },
    "instrument": {
      "rute":       { "$type": "dimension", "$value": "56px", "$description": "Rutenettet. 56px følger 8-basisen (7 × 8) og gir en rute som leses på Mac uten å bli støy på 390px", "$extensions": { "css": "--ak-rute", "fil": "instrument.css" } },
      "rute-tett":  { "$type": "dimension", "$value": "24px", "$description": "på små flater og i kort", "$extensions": { "css": "--ak-rute-tett", "fil": "instrument.css" } },
      "rute-linje": { "$type": "dimension", "$value": "1px", "$extensions": { "css": "--ak-rute-linje", "fil": "instrument.css" } },
      "rute-lys":   { "$type": "color", "$value": "rgba(20, 20, 19, 0.07)", "$description": "Styrke. Rutenettet er tekstur, aldri innhold — det skal kunne fjernes uten at noe informasjon går tapt. På lys grunn", "$extensions": { "css": "--ak-rute-lys", "fil": "instrument.css" } },
      "rute-mork":  { "$type": "color", "$value": "rgba(250, 249, 245, 0.13)", "$description": "på mørk grunn", "$extensions": { "css": "--ak-rute-mork", "fil": "instrument.css" } },
      "maal-tykk":  { "$type": "dimension", "$value": "1px", "$description": "Målestokken. Streken med merker langs en kant — merket sier «dette er målt» uten å skrive det", "$extensions": { "css": "--ak-maal-tykk", "fil": "instrument.css" } },
      "maal-merke": { "$type": "dimension", "$value": "8px",  "$description": "korte merker", "$extensions": { "css": "--ak-maal-merke", "fil": "instrument.css" } },
      "maal-hel":   { "$type": "dimension", "$value": "14px", "$description": "hvert femte, det lange", "$extensions": { "css": "--ak-maal-hel", "fil": "instrument.css" } },
      "maal-steg":  { "$type": "dimension", "$value": "12px", "$description": "avstand mellom merker", "$extensions": { "css": "--ak-maal-steg", "fil": "instrument.css" } },
      "kryss":      { "$type": "dimension", "$value": "11px", "$description": "Krysset. Settes der to akser møtes, i hjørner og ved forankringspunkter", "$extensions": { "css": "--ak-kryss", "fil": "instrument.css" } },
      "flate-min":  { "$type": "number", "$value": 0.18, "$description": "Aksentflate: en identitetsfarge dekker minst 18 % av visningen når den brukes. Overstyrer 5 %-regelen fra 31.08", "$extensions": { "css": "--ak-flate-min", "fil": "instrument.css", "kind": "other" } }
    }
  },
  "kontrast": {
    "$description": "Par som skal holde WCAG AA. `krav` 4.5 = normal tekst, 3.0 = stor tekst (fra 21 px) og grafikk. Skriptet måler i lys og mørk og feiler under krav.",
    "par": [
      { "tekst": "tekst",        "flate": "grunn",       "krav": 4.5 },
      { "tekst": "tekst",        "flate": "ark",         "krav": 4.5 },
      { "tekst": "tekst",        "flate": "grunn-senk",  "krav": 4.5 },
      { "tekst": "dempet",       "flate": "grunn",       "krav": 4.5 },
      { "tekst": "dempet",       "flate": "ark",         "krav": 4.5 },
      { "tekst": "dempet",       "flate": "grunn-senk",  "krav": 4.5 },
      { "tekst": "svak",         "flate": "grunn",       "krav": 2.5, "merk": "aldri brødtekst — kun etiketter og kanter" },
      { "tekst": "signal",       "flate": "grunn",       "krav": 4.5 },
      { "tekst": "signal",       "flate": "ark",         "krav": 4.5, "kunLys": true },
      { "tekst": "signal",       "flate": "ark",         "krav": 3.0, "kunMork": true, "merk": "på mørk ark kun som tall fra 21 px" },
      { "tekst": "signal",       "flate": "grunn-senk",  "krav": 3.0, "merk": "på senket flate kun som tall fra 21 px" },
      { "tekst": "signal-tekst", "flate": "signal-fyll", "krav": 4.5 },
      { "tekst": "fag",          "flate": "grunn",       "krav": 4.5 },
      { "tekst": "fag",          "flate": "ark",         "krav": 4.5 },
      { "tekst": "v-junior",     "flate": "grunn",       "krav": 4.5 },
