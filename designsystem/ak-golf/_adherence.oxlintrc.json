{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/flate/**",
              "components/handling/**",
              "components/maaling/**",
              "components/melding/**",
              "components/merke/**",
              "components/navigasjon/**",
              "components/skjema/**",
              "ui_kits/foreldrerapport/**",
              "ui_kits/kampanje/**",
              "ui_kits/markedsside/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:IBM Plex Sans Condensed|IBM Plex Sans|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: IBM Plex Sans Condensed, IBM Plex Sans, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Akkordeonpost'] > JSXAttribute > JSXIdentifier[name!=/^(?:tittel|innhold|key|ref|className|style|children)$/]",
        "message": "<Akkordeonpost> doesn't accept that prop. Declared props: tittel, innhold."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avkrysning'] > JSXAttribute > JSXIdentifier[name!=/^(?:merkelapp|hjelp|feil|avkrysset|onEndre|deaktivert|id|style|key|ref|className|style|children)$/]",
        "message": "<Avkrysning> doesn't accept that prop. Declared props: merkelapp, hjelp, feil, avkrysset, onEndre, deaktivert, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Smule'] > JSXAttribute > JSXIdentifier[name!=/^(?:tekst|href|key|ref|className|style|children)$/]",
        "message": "<Smule> doesn't accept that prop. Declared props: tekst, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Faktapost'] > JSXAttribute > JSXIdentifier[name!=/^(?:etikett|verdi|enhet|note|fremhevet|key|ref|className|style|children)$/]",
        "message": "<Faktapost> doesn't accept that prop. Declared props: etikett, verdi, enhet, note, fremhevet."
      },
      {
        "selector": "JSXOpeningElement[name.name='Fane'] > JSXAttribute > JSXIdentifier[name!=/^(?:noekkel|tekst|antall|key|ref|className|style|children)$/]",
        "message": "<Fane> doesn't accept that prop. Declared props: noekkel, tekst, antall."
      },
      {
        "selector": "JSXOpeningElement[name.name='Felt'] > JSXAttribute > JSXIdentifier[name!=/^(?:merkelapp|hjelp|feil|enhet|verdi|onEndre|type|plassholder|flerlinje|paakrevd|deaktivert|maalt|id|style|key|ref|className|style|children)$/]",
        "message": "<Felt> doesn't accept that prop. Declared props: merkelapp, hjelp, feil, enhet, verdi, onEndre, type, plassholder, flerlinje, paakrevd, deaktivert, maalt, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Felt'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|email|tel|number|date|password)$/]",
        "message": "<Felt> type must be one of 'text' | 'email' | 'tel' | 'number' | 'date' | 'password'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Fotokort'] > JSXAttribute > JSXIdentifier[name!=/^(?:bilde|alt|bildetekst|kilde|tekstOver|forhold|hoyde|style|key|ref|className|style|children)$/]",
        "message": "<Fotokort> doesn't accept that prop. Declared props: bilde, alt, bildetekst, kilde, tekstOver, forhold, hoyde, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IkonKnapp'] > JSXAttribute > JSXIdentifier[name!=/^(?:merkelapp|variant|storrelse|aktiv|deaktivert|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<IkonKnapp> doesn't accept that prop. Declared props: merkelapp, variant, storrelse, aktiv, deaktivert, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IkonKnapp'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:stille|fylt)$/]",
        "message": "<IkonKnapp> variant must be one of 'stille' | 'fylt'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Instrumentflate'] > JSXAttribute > JSXIdentifier[name!=/^(?:tett|mork|kryss|styrke|som|children|style|key|ref|className|style|children)$/]",
        "message": "<Instrumentflate> doesn't accept that prop. Declared props: tett, mork, kryss, styrke, som, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Knapp'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|storrelse|pill|fullBredde|deaktivert|laster|ikon|href|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Knapp> doesn't accept that prop. Declared props: variant, storrelse, pill, fullBredde, deaktivert, laster, ikon, href, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Knapp'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primaer|sekundaer|tekst)$/]",
        "message": "<Knapp> variant must be one of 'primaer' | 'sekundaer' | 'tekst'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Knapp'] > JSXAttribute[name.name='storrelse'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Knapp> storrelse must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Kort'] > JSXAttribute > JSXIdentifier[name!=/^(?:tyngde|trykkbar|aksent|rutenett|som|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Kort> doesn't accept that prop. Declared props: tyngde, trykkbar, aksent, rutenett, som, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Listepost'] > JSXAttribute > JSXIdentifier[name!=/^(?:tittel|note|verdi|merke|key|ref|className|style|children)$/]",
        "message": "<Listepost> doesn't accept that prop. Declared props: tittel, note, verdi, merke."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|hoyde|klaring|rot|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, hoyde, klaring, rot, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primaer-lys|primaer-mork|hvit-mork|hvit-mono|sort-mono|signal-mono|kvadrat|favicon)$/]",
        "message": "<Logo> variant must be one of 'primaer-lys' | 'primaer-mork' | 'hvit-mork' | 'hvit-mono' | 'sort-mono' | 'signal-mono' | 'kvadrat' | 'favicon'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Maalestokk'] > JSXAttribute > JSXIdentifier[name!=/^(?:retning|lengde|style|key|ref|className|style|children)$/]",
        "message": "<Maalestokk> doesn't accept that prop. Declared props: retning, lengde, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Maalestokk'] > JSXAttribute[name.name='retning'] > Literal[value!=/^(?:vannrett|staaende)$/]",
        "message": "<Maalestokk> retning must be one of 'vannrett' | 'staaende'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Merkelapp'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|fylt|children|style|key|ref|className|style|children)$/]",
        "message": "<Merkelapp> doesn't accept that prop. Declared props: variant, fylt, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Merkelapp'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:junior|academy|hq|organisasjon|produkt|fag|noytral)$/]",
        "message": "<Merkelapp> variant must be one of 'junior' | 'academy' | 'hq' | 'organisasjon' | 'produkt' | 'fag' | 'noytral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Mobilmeny'] > JSXAttribute > JSXIdentifier[name!=/^(?:apen|lenker|aktiv|handling|onLukk|logoRot|style|key|ref|className|style|children)$/]",
        "message": "<Mobilmeny> doesn't accept that prop. Declared props: apen, lenker, aktiv, handling, onLukk, logoRot, style."
