        "message": "<Status> doesn't accept that prop. Declared props: tilstand, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Status'] > JSXAttribute[name.name='tilstand'] > Literal[value!=/^(?:ok|varsel|feil|noytral)$/]",
        "message": "<Status> tilstand must be one of 'ok' | 'varsel' | 'feil' | 'noytral'."
