        "selector": "JSXOpeningElement[name.name='Navnelaas'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:academy|junior-academy|hq|organisasjon|products)$/]",
        "message": "<Navnelaas> variant must be one of 'academy' | 'junior-academy' | 'hq' | 'organisasjon' | 'products'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Paginering'] > JSXAttribute > JSXIdentifier[name!=/^(?:side|antallSider|onBytt|style|key|ref|className|style|children)$/]",
