        "selector": "JSXOpeningElement[name.name='Navnelaas'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|paaMorkt|hoyde|rot|style|key|ref|className|style|children)$/]",
        "message": "<Navnelaas> doesn't accept that prop. Declared props: variant, paaMorkt, hoyde, rot, style."
