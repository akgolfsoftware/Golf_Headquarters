{"nodes": [{"id": "designsystem_train_lock_ao_12_godkjenningspolicy_a3_b1_c3_dc", "label": "AO-12 Godkjenningspolicy A3 \u00b7 B1 \u00b7 C3", "file_type": "document", "source_file": "designsystem/train-lock/AO-12 Godkjenningspolicy A3 B1 C3.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "designsystem_train_lock_ao_12_a3_start_godkjenning_regel", "label": "A3: krav om start-godkjenning (sky + \u00d8KONOMI/PERSONLIG/DRIFT + writeTargets\u2260none)", "file_type": "rationale", "source_file": "designsystem/train-lock/AO-12 Godkjenningspolicy A3 B1 C3.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requires explicit human start-approval only when a task runs in the cloud, touches a sensitive Area, or actually writes somewhere \u2014 local Ollama read/report tasks auto-start without a dialog, keeping approval friction proportional to risk."}, {"id": "designsystem_train_lock_ao_12_c3_research_uten_skriv", "label": "C3: research uten skriv aldri i godkjenn-k\u00f8", "file_type": "rationale", "source_file": "designsystem/train-lock/AO-12 Godkjenningspolicy A3 B1 C3.dc.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A finished research task with writeTargets=none is marked Ferdig automatically and surfaces only as a badge in Cockpit, never blocking the AO-08 approval queue \u2014 keeps the queue reserved for tasks with real side effects."}], "edges": [{"source": "designsystem_train_lock_ao_12_godkjenningspolicy_a3_b1_c3_dc", "target": "designsystem_train_lock_ao_12_a3_start_godkjenning_regel", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "designsystem/train-lock/AO-12 Godkjenningspolicy A3 B1 C3.dc.html", "source_location": null, "weight": 1.0}, {"source": "designsystem_train_lock_ao_12_godkjenningspolicy