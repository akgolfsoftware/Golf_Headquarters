{"nodes": [{"id": "designsystem_paper_fase1_kontrakt_byggekontrakt", "label": "Byggekontrakt \u00b7 Fase 1", "file_type": "document", "source_file": "designsystem/paper/fase1/KONTRAKT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gjelder alle filer i fase1-mappa; brudd underkjenner leveransen. Fasit for hvilke regler alle Fase 1-skjermene m\u00e5les mot: filformat, tokens, aksentmonopol, trykkflater, interaksjoner som virker, obligatoriske tilstander, spr\u00e5k/domene, delt demodata, F\u00d8R\u2192UNDER\u2192ETTER-lenking, navigasjon."}, {"id": "designsystem_paper_fase1_kontrakt_aksentmonopol_regel", "label": "Regel: n\u00f8yaktig \u00e9n .btn.now per skjermtilstand", "file_type": "rationale", "source_file": "designsystem/paper/fase1/KONTRAKT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Aksentfargen er reservert for skjermens ene handling (\u00ab\u00c9n ting n\u00e5\u00bb) + focus-ring + logoprikk. Aldri p\u00e5 badges, tall, statuspunkter eller dekorasjon \u2014 s\u00e5 fargen fortsatt betyr noe."}, {"id": "designsystem_paper_fase1_kontrakt_trykkflate_regel", "label": "Regel: trykkflate-gulv 44/48/60 px uansett pekertype", "file_type": "rationale", "source_file": "designsystem/paper/fase1/KONTRAKT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gulvet heves for alle pekertyper, ikke bare pointer:coarse, fordi Anders ba om \u226544px flatt. .btn.now \u226548px, fangst/mikrofon \u226560px."}, {"id": "designsystem_paper_fase1_kontrakt_tilstander_regel", "label": "Regel: tom/laster/feil/suksess er obligatorisk og demonstrerbart", "file_type": "rationale", "source_file": "designsystem/paper/fase1/KONTRAKT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hver skjerm m\u00e5 ha en .state-switch demo-rad (merket data-demo-only) som faktisk bytter DOM-tilstand \u2014 feilteksten skal si hva som feilet og hva brukeren kan gj\u00f8re, aldri \u00abnoe gikk galt\u00bb."}, {"id": "designsystem_paper_fase1_kontrakt_demodata_kanon", "label": "Demodata \u2014 \u00e9n sannhet p\u00e5 tvers av alle Fase 1-filer", "file_type": "concept", "source_file": "designsystem/paper/fase1/KONTRAKT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fastl\u00e5ste navn/tall (Anders Kristiansen, \u00d8yvind Rohjan kat. D, Jonas Hveem, Filip Sandberg, Mia Kolstad, Mulligan Indoor Sim 1-3) hindrer at hver skjermfil finner opp egne demo-navn og skaper sprik."}, {"id": "designsystem_paper_fase1_kontrakt_navigasjon_regel", "label": "Regel: maks fem AgencyOS-flater, fire PlayerHQ-faner", "file_type": "rationale", "source_file": "designsystem/paper/fase1/KONTRAKT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AgencyOS-rail: Konsoll \u00b7 Innboks \u00b7 Spillere \u00b7 Kalender \u00b7 Workbench (l\u00e5st av Anders 05.08.2026). Alt annet via chat eller \u2318K. tabItems \u2286 railItems tvinger samme navnesett i desktop og mobil."}], "edges": [{"source": "designsystem_paper_fase1_kontrakt_byggekontrakt", "target": "designsystem_paper_fase1_agencyos_konsoll_desktop_skjerm", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "designsystem/paper/fase1/KONTRAKT.md", "source_location": null, "weight": 1.0}, {"source": "designsystem_paper_fase1_kontrakt_byggekontrakt", "target": "designsystem_paper_fase1_agencyos_konsoll_mobil_skjerm", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "designsystem/paper/fase1/KONTRAKT.md", "source_location": null, "weight": 1.0}, {"source": "designsystem_paper_fase1_kontrakt_byggekontrakt", "target": "designsystem_p