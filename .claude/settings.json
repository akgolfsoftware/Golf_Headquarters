{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git checkout -b*)",
      "Bash(npm run*)",
      "Bash(npm install*)",
      "Bash(npx prisma validate*)",
      "Bash(npx prisma generate*)",
      "Bash(npx tsc*)",
      "Bash(cd * && git status*)",
      "Bash(cd * && git log*)",
      "Bash(cd * && git diff*)",
      "Bash(cd * && git show*)",
      "Bash(cd * && git fetch*)",
      "Bash(cd * && git branch --show-current*)",
      "Bash(cd * && git worktree list*)",
      "Bash(cd * && gh pr view*)",
      "Bash(cd * && gh pr list*)",
      "Bash(cd * && gh pr checks*)",
      "Bash(git fetch*)",
      "Bash(git show*)",
      "Bash(git worktree list*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "mcp__claude-design__read_file",
      "mcp__claude-design__list_files",
      "mcp__claude-design__list_projects",
      "mcp__claude-design__get_conversation",
      "mcp__claude-design__render_preview",
      "mcp__ccd_pr__get_status",
      "mcp__claude_ai_Google_Calendar__list_events",
      "mcp__claude_ai_Google_Calendar__list_calendars",
      "mcp__claude_ai_Gmail__search_threads",
      "mcp__plugin_vercel_vercel__get_runtime_logs",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "mcp__claude-in-chrome__find"
    ],
    "ask": [
      "Bash(git checkout main)",
      "Bash(git checkout master)",
      "Bash(git reset*)",
      "Bash(gh pr merge*)",
      "Bash(rm -rf*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/env-lenke.mjs\""
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hvem-jobber-hvor.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/beskytt.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/beskytt.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/kvalitet.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/logg.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/rydd-etter-merge.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/varsle-telegram.mjs\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true,
    "supabase@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "stripe@claude-plugins-official": true,
    "prisma@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "superpowers@superpowers-dev": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "superpowers-dev": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers"
      }
    }
  },
  "skillOverrides": {
    "design-taste-frontend": "off",
    "emil-design-eng": "off",
    "frontend-design": "off",
    "animate": "off",
    "find-animation-opportunities": "off",
    "improve-animations": "off",
    "review-animations": "off",
    "design-system": "off",
    "web-design-guidelines": "off",
    "hallmark": "off",
    "high-end-visual-design": "off",
    "minimalist-ui": "off",
    "redesign-existing-projects": "off",
    "anti-ui-slop": "off",
    "image-to-code": "off",
    "apple-design": "off",
    "better-ui": "off",
    "ui-ux-pro-max": "off",
    "brandkit": "off",
    "extract-design-system": "off",
    "animation-vocabulary": "off"
  }
}
